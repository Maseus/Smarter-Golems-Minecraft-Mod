{
	"schemaVersion": 1,
	"id": "smartergolems",
	"version": "${version}",
	"name": "Smarter Golems",
	"description": "Give copper golems jobs. Sneak + right-click a copper golem to assign a task, such as farming the area around it.",
	"authors": [
		"Maseus"
	],
	"contact": {
		"homepage": "https://github.com/Maseus/Smarter-Golems-Minecraft-Mod",
		"sources": "https://github.com/Maseus/Smarter-Golems-Minecraft-Mod",
		"issues": "https://github.com/Maseus/Smarter-Golems-Minecraft-Mod/issues"
	},
	"license": "MIT",
	"icon": "assets/smartergolems/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.smartergolems.SmarterGolems"
		],
		"client": [
			"com.smartergolems.client.SmarterGolemsClient"
		]
	},
	"mixins": [
		"smartergolems.mixins.json",
		{
			"config": "smartergolems.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
